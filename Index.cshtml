@model IEnumerable<BoardGameStore.Models.BoardGame>

@{
    ViewData["Title"] = "Наш магазин настолок";
}

<div class="container mt-4">
    <h1 class="text-center mb-4">Каталог настольных игр</h1>
    
    <div class="row">
        @foreach (var game in Model)
        {
            <div class="col-md-3 mb-4">
                <div class="card h-100 shadow-sm">
                    <img src="@game.ImageUrl" class="card-img-top" alt="@game.Name">
                    <div class="card-body">
                        <h5 class="card-title">@game.Name</h5>
                        <p class="card-text text-muted">@game.Description</p>
                    </div>
                    <div class="card-footer bg-white border-top-0">
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="badge bg-primary fs-6">@game.Price.ToString("C")</span>
                            <button class="btn btn-outline-success btn-sm">В корзину</button>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
